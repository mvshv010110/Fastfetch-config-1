{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none",
        "source": "/home/mvshv/Dokumenty/fastfetch/Echidna.png",
        "width": 28,
        "padding": {
            "top": 0,
            "bottom": 0,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "color": "blue"
    },
    "modules": [
        {
           "type": "custom",
           "key": "-----------------------------------------------------------------------"
       },
        {
            "type": "cpu",
            "key": " CPU                                       ",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU 1                          ",
            "hideType": "integrated",
            "format": "{name} Femboy Edition"
        },
        {   
            "type": "gpu",
            "key": "󰘍 Driver                                ",
            "format": "{driver}",
            "hideType": "integrated" 
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU 2                                     ",
            "hideType": "discrete",
            "format": "{name} {type}"
        },
        {   
            "type": "gpu",
            "key": "󰘍 Driver                                                          ",
            "format": "{driver}",
            "hideType": "discrete"
        },
        {
            "type": "memory",
            "key": " RAM                                       ",
            "format": "{1} / {2} ({3})",
        },
        {
            "type": "disk",
            "key": "󰋊 System                           ",
            "folders": "/",
            "format": "{1} / {2} ({3}) - {9}"
        },
        {
            "type": "disk",
            "folders": "/mnt/Gry",
            "key": "󰋊 Gry                            ",
            "format": "{1} / {2} ({3}) - {9}"
        },
         {
            "type": "custom",
            "key": "-----------------------------------------------------------------------"
        },
        {
            "type": "colors",
            "key": " Colors",
            "symbol": "circle"
        },
        {"type": "break"}
    ]
}
