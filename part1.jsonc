{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "/home/mvshv/Dokumenty/fastfetch/Emilia.png",
        "width": 28,
        "padding": {
            "top": 0,
            "bottom": 0,
            "left": 2
        }
    },
    "display": {
        "separator": " ",
        "color": "blue"
    },
    "modules": [
        {
            "type": "title",
            "key": " User           ",
            "format": "{1}@{2}"
        },
          {
            "type": "custom",
            "key": "-------------------------------------"
        },
        {
            "type": "os",
            "key": " OS      ",
            "format": "I use {name} btw :3"
        },
        {
            "type": "kernel",
            "key": " Kernel  "
        },
        {
            "type": "uptime",
            "key": "󱎫 Uptime        "
        },
        {
            "type": "shell",
            "key": " Shell                   "
        },
        {
            "type": "display",
            "key": "󰍹 Display          ",
            "format": "{width}x{height} @ {refresh-rate} Hz"
        },
        {
            "type": "wm",
            "key": " WM       "
        },
        {
            "type": "de",
            "key": "󰧨 DE"
        },
        {
            "type": "terminal",
            "key": " Terminal              "
        },
        {
            "type": "packages",
            "key": "󰏗 Pkg     "
        },
        {
            "type": "locale",
            "key": "󰇧 Locale                 "
        },
        {
        	"type": "cursor",
        	"key": "󰇀 Cursor         "
        }
    ]
}
